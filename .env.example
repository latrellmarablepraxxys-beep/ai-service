# Application
NODE_ENV=development
PORT=3001
# Public base URL of this service. Empty -> http://localhost:$PORT.
APP_URL=http://localhost
FRONTEND_URL=http://localhost:3000
# Express `trust proxy`: empty = direct connections, true/false, or a hop count (e.g. 1)
TRUST_PROXY=

# Domain admin API (tickets, agents, SLA) - NOT owned by this service
DOMAIN_API_URL=http://localhost:8000/api
DOMAIN_API_KEY=
DOMAIN_API_TIMEOUT_MS=10000

# AI service API key (used by the Laravel app to call this service)
AI_API_KEY=dev-key

# AI providers (OpenAI-compatible; presets in src/config/aiProviders.ts)
# Select the active provider with AI_PROVIDER. Empty values -> provider preset.
AI_PROVIDER=openai
# openai  -> base https://api.openai.com/v1          chat gpt-4o-mini
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_CLASSIFIER_MODEL=
OPENAI_EMBEDDING_MODEL=
# ollama  -> base http://localhost:11434/v1          chat llama3.2 (no key needed)
OLLAMA_BASE_URL=
OLLAMA_API_KEY=
OLLAMA_CHAT_MODEL=
OLLAMA_CLASSIFIER_MODEL=
OLLAMA_EMBEDDING_MODEL=
# novita  -> base https://api.novita.ai/v3/openai    chat deepseek/deepseek-v3
NOVITA_BASE_URL=
NOVITA_API_KEY=
NOVITA_CHAT_MODEL=
NOVITA_CLASSIFIER_MODEL=
NOVITA_EMBEDDING_MODEL=

# Embeddings (separate OpenAI-compatible endpoint; empty -> provider connection)
# Used for RAG: vectorizes KB/FAQ for Typesense and the incoming message.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1024

# MongoDB (conversation state: threads, messages, memories, runs)
MONGODB_URI=mongodb://localhost:27017/motorcentral-omnichannel-ai
MONGODB_DB=motorcentral-omnichannel-ai

# Redis (cache + BullMQ)
REDIS_URL=redis://localhost:6379
# Cache-connection command timeout (ms); queue connections keep maxRetriesPerRequest:null
REDIS_COMMAND_TIMEOUT_MS=2000

# Typesense (search / RAG, shared with Laravel)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
# Prefix for this service's own collections (dev default: ai_).
# When consuming the shared Laravel index (Scout+Typesense, no prefix), set this
# to empty (TYPESENSE_COLLECTION_PREFIX=) and address the Laravel-owned collection
# by name, e.g. crm_vector_ai.
TYPESENSE_COLLECTION_PREFIX=ai_
TYPESENSE_CONNECTION_TIMEOUT_SECONDS=5

# Webhooks (optional for now — required once the webhook route lands)
WEBHOOK_VERIFY_TOKEN=
WEBHOOK_SIGNING_SECRET=

# Mock admin API (dev tooling) — mirrors the Laravel admin's /api/v1.
# Start with `npm run mock:admin`; point DOMAIN_API_URL at http://localhost:$MOCK_ADMIN_API_PORT/api.
MOCK_ADMIN_API_PORT=8000

# Logging
LOG_LEVEL=info
LOG_DIR=./logs

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
