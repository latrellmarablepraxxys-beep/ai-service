{
  "name": "motorcentral-omnichannel-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MotorCentral Omnichannel AI service (TypeScript + Express + LangGraph).",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run lint && npm test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "llm:smoke": "tsx scripts/llmSmoke.ts",
    "db:init-collections": "tsx scripts/initCollections.ts",
    "db:create-indexes": "tsx scripts/createIndexes.ts",
    "db:setup": "npm run db:init-collections && npm run db:create-indexes",
    "db:ping": "tsx scripts/pingDatabase.ts",
    "db:clear": "tsx scripts/clearDatabase.ts",
    "db:fresh": "tsx scripts/freshDatabase.ts",
    "mongo:init": "npm run db:setup",
    "typesense:init": "tsx scripts/initTypesense.ts",
    "db:seed": "tsx scripts/seed.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "axios": "^1.7.0",
    "bullmq": "^5.12.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "mongodb": "^6.8.0",
    "pino": "^9.3.0",
    "prom-client": "^15.1.3",
    "typesense": "^1.8.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "^2.0.5",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-check-file": "^3.3.2",
    "husky": "^9.1.5",
    "lint-staged": "^15.2.10",
    "pino-pretty": "^11.2.2",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.0.5"
  },
  "lint-staged": {
    "*.ts": ["eslint --fix"]
  }
}
